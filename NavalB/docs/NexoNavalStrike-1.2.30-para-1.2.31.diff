+.mn-idx { flex: 1; min-height: 0; overflow: auto; touch-action: pan-y; }
+.mn-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; align-content: start; }
+.mn-card-cat { display: flex; align-items: center; gap: 10px; text-align: left; background: #04060a; border: 1px solid rgba(56,189,248,.22); border-radius: 10px; padding: 10px 12px; color: #e2e8f0; min-height: 78px; position: relative; }
+.mn-card-cat:active { border-color: #38bdf8; background: #0a121c; }
+.mn-card-cat svg { width: 22px; height: 22px; flex: none; fill: none; stroke: #38bdf8; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
+.mn-card-cat b { display: block; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; }
