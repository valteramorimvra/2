+.mn { flex: 1; min-height: 0; min-width: 0; max-width: 100%; display: flex; flex-direction: column; gap: 6px; color: #e2e8f0; padding-top: 2px; }
+.mn-cab { padding-right: 96px; min-height: 44px; } .mn-cab > div { display: flex; align-items: center; gap: 10px; flex-wrap: nowrap; white-space: nowrap; }
+.mn-cab h2 { margin: 0; font-size: 18px; letter-spacing: .14em; font-weight: 700; color: #e2e8f0; }
+.mn-cab h2 small { font-size: 10px; letter-spacing: .08em; color: #64748b; font-weight: 600; margin-left: 4px; }
+.mn-mig { font-size: 12px; color: #94a3b8; margin-left: 10px; }
